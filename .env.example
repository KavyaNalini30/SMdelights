# Copy this file to .env.local and fill in the values. Never commit .env.local.
# See SETUP.md for where to find each value.

# --- Site ---
# Local: http://localhost:3000   Production: https://your-domain.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# Leave RAZORPAY_KEY_ID empty to run checkout in DEMO MODE (no real payments).
RAZORPAY_KEY_ID=
# SERVER ONLY.
RAZORPAY_KEY_SECRET=
# SERVER ONLY. The secret you type when creating the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# --- Order emails: Resend (resend.com -> API Keys). Empty = emails are skipped. ---
# SERVER ONLY.
RESEND_API_KEY=
# Until your domain is verified in Resend, leave EMAIL_FROM empty (uses onboarding@resend.dev,
# which can only send to the Resend account's own email). After: SM Delights <orders@your-domain.in>
EMAIL_FROM=
# Where new-order alerts are emailed (also the reply-to address on customer emails).
OWNER_EMAIL=

# --- WhatsApp Cloud API (Meta). Empty = WhatsApp messages are skipped. See SETUP.md section 11. ---
# SERVER ONLY. A permanent System User access token.
WHATSAPP_TOKEN=
# The Phone number ID of the business number (WhatsApp Manager -> API Setup), not the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# Number that receives new-order alerts. Must be different from the business number.
OWNER_WHATSAPP=9092322597
