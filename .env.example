# Copy this file to .env.local and fill in the values. Never commit .env.local.
# See SETUP.md for where to find each value.

# --- Site ---
# Local: http://localhost:3000   Production: https://your-domain.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# Leave RAZORPAY_KEY_ID empty to run checkout in DEMO MODE (no real payments).
RAZORPAY_KEY_ID=
# SERVER ONLY.
RAZORPAY_KEY_SECRET=
# SERVER ONLY. The secret you type when creating the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
